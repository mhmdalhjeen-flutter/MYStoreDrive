# =============================================================================
# Monorepo environment reference
# Copy workspace-specific examples to local .env files (never commit secrets)
# =============================================================================
#
#   backend/.env       ← backend/.env.example
#   store/.env.local   ← store/.env.example
#   admin/.env.local   ← admin/.env.example
#
# See docs/DATABASE_SETUP.md for the full local development workflow.

# PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/arabic_ecommerce?schema=public"

# Production PostgreSQL with SSL (example format only — do not use real credentials)
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public&sslmode=require"

# Backend
NODE_ENV=development
PORT=3001
BACKEND_PORT=3001
BACKEND_URL=http://localhost:3001
API_PREFIX=api

# JWT
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# Database seed (backend only)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-min-12-chars

# CORS
STORE_FRONTEND_URL=http://localhost:3000
ADMIN_FRONTEND_URL=http://localhost:3002

# Store / Admin (public)
NEXT_PUBLIC_API_URL=http://localhost:3001/api
