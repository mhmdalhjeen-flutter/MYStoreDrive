# Backend API environment variables.
# Copy to backend/.env for local development. Never commit real values.
# All values here are secrets or server-side configuration and must never
# be exposed to the Store or Admin frontends.

# --- Database (required, secret) ---
# Managed PostgreSQL connection string. Cloud providers usually require SSL:
#   postgresql://<user>:<password>@<host>:5432/<database>?schema=public&sslmode=require
DATABASE_URL=

# --- Runtime (optional) ---
NODE_ENV=development
BACKEND_PORT=3001
API_PREFIX=api

# --- JWT (required, secret) ---
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=24h
# Separate secret used to sign refresh tokens. Falls back to JWT_SECRET when
# unset, but a distinct value is required for cloud/staging/production.
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# --- OTP (optional) ---
OTP_EXPIRES_IN=10m
OTP_MAX_ATTEMPTS=3

# --- CORS (required in cloud) ---
# Exact origins of the deployed frontends. No wildcards; credentials are enabled.
STORE_FRONTEND_URL=http://localhost:3000
ADMIN_FRONTEND_URL=http://localhost:3002

# --- Security (optional) ---
BCRYPT_ROUNDS=12

# --- Rate limiting (optional) ---
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100
