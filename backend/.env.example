# =============================================================================
# Backend environment (copy to backend/.env — never commit .env)
# =============================================================================

# PostgreSQL — required
# Local:  postgresql://USER:PASSWORD@localhost:5432/DATABASE?schema=public
# Cloud:  postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public&sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/arabic_ecommerce?schema=public"

# Server
NODE_ENV=development
PORT=3001
BACKEND_PORT=3001
BACKEND_URL=http://localhost:3001
API_PREFIX=api

# JWT — required (use strong random values in production, min 32 chars)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# Seed (required when running npm run prisma:seed)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-min-12-chars
SEED_ADMIN_PHONE=0590000000
SEED_ADMIN_NAME=مدير النظام

# OTP
OTP_EXPIRES_IN=10m
OTP_MAX_ATTEMPTS=3
OTP_RATE_LIMIT=5

# CORS — required in production
STORE_FRONTEND_URL=http://localhost:3000
ADMIN_FRONTEND_URL=http://localhost:3002

# File upload (local storage for development)
MAX_FILE_SIZE=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
UPLOAD_DIR=uploads

# Rate limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Security
BCRYPT_ROUNDS=12

# SMS (optional — not required for local dev)
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
