# Backend API environment variables.
# Copy to backend/.env for local development. Never commit real values.
# All values here are secrets or server-side configuration and must never
# be exposed to the Store or Admin frontends.

# --- Database (required, secret) ---
# Managed PostgreSQL connection string. Cloud providers usually require SSL:
#   postgresql://<user>:<password>@<host>:5432/<database>?schema=public&sslmode=require
# On Neon, use the pooled host ("-pooler" in the hostname) for the running API and
# the direct host for `prisma migrate`.
DATABASE_URL=

# --- Runtime (optional) ---
NODE_ENV=development
# Cloud platforms inject PORT; it takes precedence over BACKEND_PORT.
# The server always binds 0.0.0.0.
BACKEND_PORT=3001
API_PREFIX=api
# Swagger is served at /<API_PREFIX>/docs. Disabled in production unless set to true.
SWAGGER_ENABLED=false

# --- JWT (required, secret) ---
# Generate with: openssl rand -base64 48
# In production both must be at least 32 characters and must differ from each
# other; the backend refuses to start otherwise.
JWT_SECRET=
JWT_EXPIRES_IN=24h
# Separate secret used to sign refresh tokens. Falls back to JWT_SECRET in
# development; required in production.
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# --- OTP (optional) ---
OTP_EXPIRES_IN=10m
OTP_MAX_ATTEMPTS=3

# --- CORS (required in production) ---
# Comma-separated exact origins allowed to call the API. No wildcards;
# credentials are enabled. STORE_FRONTEND_URL/ADMIN_FRONTEND_URL are merged in.
# When none are set, development falls back to the two localhost origins and
# production refuses to start.
CORS_ORIGINS=
STORE_FRONTEND_URL=http://localhost:3000
ADMIN_FRONTEND_URL=http://localhost:3002

# --- Security (optional) ---
BCRYPT_ROUNDS=12

# --- Rate limiting (optional) ---
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100

# --- Seed (secret, only needed when running npm run db:seed) ---
# The seed refuses to run without these; no default admin password exists.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_PHONE=0590000000
# The seed refuses to run when NODE_ENV=production unless this is exactly "true".
ALLOW_PRODUCTION_SEED=
