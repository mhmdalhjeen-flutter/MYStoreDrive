# Store frontend environment variables.
# Copy to store/.env.local for local development.
# Every NEXT_PUBLIC_* value is embedded in the browser bundle at build time:
# only public configuration belongs here, never a backend secret.

# Base URL of the Backend API, including the /api prefix (required, public).
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Origin that serves product images. Defaults to NEXT_PUBLIC_API_URL.
# Set this when images move to cloud object storage (optional, public).
NEXT_PUBLIC_IMAGE_BASE_URL=
